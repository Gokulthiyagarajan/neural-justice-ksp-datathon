# =============================================================================
# .env.example — Copy to .env and fill in your values
# =============================================================================
# Keys marked "<leave blank — set in Catalyst Console>" are injected by Zoho Catalyst
# in production/staging. Do NOT set them locally unless testing against live services.
# =============================================================================
# This file is the authoritative template for all environment variables.
# Never commit .env — commit this file instead.
# =============================================================================


# --- Application ---
ENVIRONMENT=development
APP_NAME=Neural Justice
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en


# --- Project (Zoho Catalyst) ---
CATALYST_PROJECT_ID=your-catalyst-project-id
CATALYST_ENVIRONMENT=development


# --- Authentication (JWT) ---
# Local dev secrets — CHANGE before any non-local use. Keep JWT_SECRET === JWT_SECRET_KEY.
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Catalyst API Gateway uses these:
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800


# --- Encryption ---
# Local dev Fernet key — CHANGE before any non-local use.
ENCRYPTION_KEY=your-fernet-encryption-key-here


# --- Database ---
# SQLite for local development; PostgreSQL via Catalyst Data Store in production.
DATABASE_URL=sqlite:///dev-test.db


# --- Data Store (Catalyst PostgreSQL) ---
CATALYST_DATASTORE_URL=<leave blank — set in Catalyst Console>
CATALYST_DATASTORE_MAX_CONNECTIONS=20
CATALYST_DATASTORE_TIMEOUT=30000


# --- NoSQL (Catalyst) ---
CATALYST_NOSQL_URL=<leave blank — set in Catalyst Console>


# --- Stratus (Catalyst File Storage) ---
CATALYST_STRATUS_BUCKET_PREFIX=nj-files
CATALYST_STRATUS_REGION=us-int
CATALYST_STRATUS_MAX_FILE_SIZE=52428800


# --- Cache (Catalyst / Redis) ---
CATALYST_CACHE_HOST=<leave blank — set in Catalyst Console>
CATALYST_CACHE_PORT=6379
CATALYST_CACHE_TTL_DASHBOARD=300
CATALYST_CACHE_TTL_ANALYTICS=600
CATALYST_CACHE_TTL_GEO=900
CATALYST_CACHE_TTL_RISK_SCORE=1800
CATALYST_CACHE_TTL_RECENT_FIR=120
CATALYST_CACHE_TTL_CONVERSATION=3600


# --- API Gateway ---
CATALYST_API_GATEWAY_URL=<leave blank — set in Catalyst Console>
CATALYST_API_RATE_LIMIT_WINDOW=60000
CATALYST_API_RATE_LIMIT_MAX=100


# --- Zia AI Services ---
CATALYST_ZIA_OCR_KEY=<leave blank — set in Catalyst Console>
CATALYST_ZIA_OCR_MODEL=standard
CATALYST_ZIA_SPEECH_KEY=<leave blank — set in Catalyst Console>
CATALYST_ZIA_SPEECH_LANGUAGE=kn-IN
CATALYST_ZIA_TRANSLATION_KEY=<leave blank — set in Catalyst Console>
CATALYST_ZIA_TRANSLATION_SOURCE=en
CATALYST_ZIA_TRANSLATION_TARGET=kn


# --- SmartBrowz (PDF Generation) ---
CATALYST_SMARTBROWZ_KEY=<leave blank — set in Catalyst Console>
CATALYST_SMARTBROWZ_TEMPLATE_DIR=smartbrowz/templates


# --- Mail ---
CATALYST_MAIL_SENDER=noreply@neural-justice.ksp.gov.in
CATALYST_MAIL_SENDER_NAME="Neural Justice"
SUPPORT_EMAIL=neuraljustice@neuraljustice.jo3.org


# --- Push Notifications ---
CATALYST_PUSH_KEY=<leave blank — set in Catalyst Console>
CATALYST_PUSH_ANDROID_CHANNEL=nj-default
CATALYST_PUSH_IOS_CHANNEL=nj-default


# --- Additional Catalyst Services ---
CATALYST_AUTH_DOMAIN=https://accounts.zoho.com
CATALYST_AUTH_ENABLED=false
CATALYST_SIGNALS_KEY=<leave blank — set in Catalyst Console>
CATALYST_AUTOML_KEY=<leave blank — set in Catalyst Console>

# --- Google OAuth (Catalyst Embedded Authentication) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_ALLOWED_DOMAINS=ksp.gov.in,police.gov.in
CATALYST_GOOGLE_SOCIAL_LOGIN_ENABLED=false


# --- TURNSTILE (Cloudflare CAPTCHA) ---
# Disabled in development (empty). Required for production/staging.
TURNSTILE_SECRET_KEY=<leave blank — set in Catalyst Console>
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify


# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# --- Security ---
CSRF_COOKIE_SECURE=false
HELMET_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60
DATA_STORE_NAME=NeuralJustice
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true


# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=both
NJ_REQUEST_TIMING=false


# --- Data Governance ---
DATA_RETENTION_DAYS_CASES=2555
DATA_RETENTION_DAYS_EVIDENCE=2555
DATA_RETENTION_DAYS_AUDIT=365
AI_LOG_RETENTION_DAYS=730
DATA_ANONYMIZE_AFTER_DAYS=1825
PURPOSE_LIMITATION_CHECK_ENABLED=true


# --- QuickML (Zoho Catalyst ML Pipelines) ---
QUICKML_MODEL_BASE_PATH=quickml/models
QUICKML_API_KEY=<leave blank — set in Catalyst Console>
QUICKML_TRAINING_SCHEDULE=0 2 * * 0
# For the new LLM Serving auth (Zoho OAuth2) — see .env.example AI section below.
QUICKML_ENDPOINT_KEY=<leave blank — set via Catalyst Console>
QUICKML_OAUTH_TOKEN=<leave blank — set via Catalyst Console>
QUICKML_ORG_ID=<leave blank — set via Catalyst Console>


# --- AI / LLM ---
# MOCK_AI=true runs the app without a live LLM/QuickML key (recommended for local dev).
MOCK_AI=true
# Provider selection: "quickml" (Zoho Catalyst QuickML LLM Serving) or "ollama" (local).
# NOTE: This env var is PROVIDER (not AI_PROVIDER). The pydantic settings class
# uppercases the field name `provider` → reads env var PROVIDER.
PROVIDER=quickml
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_ENABLE_CACHE=true
# Auth mode for QuickML LLM Serving: "bearer" (OpenAI-compatible), "zoho_oauth" (Zoho OAuth2),
# or "catalyst_sdk" (auto-auth inside Catalyst runtime).
QUICKML_AUTH_MODE=bearer
# QuickML endpoint URL — leave blank to use provider default.
# When using the Catalyst Console, get the real endpoint from:
#   QuickML → Generative AI → LLM Serving → pick model → API Details
QUICKML_ENDPOINT=
# Embedding model to use for RAG vector search.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
VECTOR_STORE_PATH=./data/vectors
# Generation defaults (overridable per-request)
MAX_TOKENS=2048
TEMPERATURE=0.1


# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,txt,csv,xlsx


# --- Development Only (remove in production) ---
# These overrides allow local development without a Catalyst backend.
DEFAULT_LOGIN_PASSWORD=test123
DEFAULT_LOGIN_ROLES=["SUPER_ADMIN"]
DEFAULT_LOGIN_DISTRICT_ID=1
DEFAULT_LOGIN_STATION_ID=1
