# Neural Justice — Local Development Overrides
# Copy this file to .env.local for local dev. Never commit .env.local.

# Set to "true" to enable the one-click demo login path (auto-fills rank cards
# with the demo credentials defined in src/auth/constants/mockCredentials.ts).
# MUST be "false" or absent in all production / CI builds.
VITE_DEMO_MODE=true
