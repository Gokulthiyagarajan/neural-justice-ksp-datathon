# =============================================================================
# Neural Justice — Frontend Production Build Environment
# =============================================================================
# IMPORTANT: These are BUILD-TIME vars baked into the JS bundle at `vite build`.
# They are NOT readable at runtime after build. Must be set BEFORE building.
#
# Build command must include --mode production:
#   npx vite build --mode production
#
# If you build without --mode production, Vite loads .env (if it exists) or
# defaults to empty strings, which WILL break all API calls and Google login.
# =============================================================================

# Backend API URL — must point to the live deployed Advanced I/O function
# This is the base URL WITHOUT /api suffix — the central client (/src/api/client.ts)
# appends /api automatically. DashboardApi.ts also uses this directly.
# Format: https://<project-domain>.development.catalystserverless.com/server/<function-name>
# Get this from: Catalyst Console → Functions → neural-justice-backend → URL
VITE_API_URL = https://neural-justice-60077006311.development.catalystserverless.in/server/neural-justice-backend

# Google OAuth 2.0 Client ID — for "Sign in with Google" login
# Get this from: Google Cloud Console → APIs & Services → Credentials
# → OAuth 2.0 Client IDs → Web application → Client ID
VITE_GOOGLE_CLIENT_ID = 850396773553-n244e63n0h7k0375lq80b4675l371565.apps.googleusercontent.com
